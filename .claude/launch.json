{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "client"],
      "port": 5173
    },
    {
      "name": "server-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--prefix", "server"],
      "port": 2567
    },
    {
      "name": "server-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import=data:text/javascript,process.env.NODE_ENV='production';process.env.PORT='8080';", "server/build/index.js"],
      "port": 8080
    }
  ]
}
